# =============================================================================
# .env.example — copy this to .env and adjust.
#
#   cp .env.example .env
#
# .env is gitignored: it is the one place real credentials live locally, and it
# must never be committed. This file is the committed reference for what keys
# .env is expected to contain, so keep every value here a placeholder.
#
# Who reads these:
#   * the Flask app  — python-dotenv loads .env at startup (DATABASE_URL, PORT,
#                      LOG_FILE)
#   * Docker Compose — automatically substitutes ${...} in docker-compose.yml
#                      (POSTGRES_PASSWORD, IMAGE_VERSION)
#
# None of this applies to the Kubernetes deployment. There, secrets come from
# Vault through External Secrets Operator and never touch a file — see
# "How secrets flow" in README.md.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# SQLAlchemy connection string.
#   Running the app on your host (make run):        host is localhost
#   Running the app in Docker Compose (make up):    host is the "db" service
# Compose sets this itself, so it only matters for the non-Docker setup.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/students_db

# Port the Flask server binds to.
PORT=5000

# Where the app writes its log file. In Compose this path is inside the
# container and is bind-mounted to /var/log/sre-student-api on the host.
LOG_FILE=/app/logs/app.log

# -----------------------------------------------------------------------------
# Docker Compose
# -----------------------------------------------------------------------------

# Password for the postgres superuser in the "db" service. Compose falls back to
# "postgres" if this is unset, which is fine locally and nowhere else.
# Generate a real one with:  openssl rand -hex 16
POSTGRES_PASSWORD=postgres

# Tag applied to the image Compose builds (sre-student-api:<tag>).
# Defaults to 1.0.0 if unset. CI overrides this with the commit SHA.
IMAGE_VERSION=1.0.0
